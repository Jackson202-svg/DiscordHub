# Copy to .env locally. Never commit .env or real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
REQUEST_TIMEOUT_MS=8000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
GITHUB_TOKEN=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
# PostgreSQL required for accounts/favorites/admin APIs
DATABASE_URL=
DATABASE_SSL=false
# Set temporarily to bootstrap first admin, then remove
ADMIN_BOOTSTRAP_TOKEN=
# Optional OpenAI-compatible chat-completions provider
AI_API_URL=
AI_API_KEY=
AI_MODEL=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# PHP admin console only
ADMIN_PASSWORD_HASH=
