# Copy to .env locally. Never commit .env or real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
REQUEST_TIMEOUT_MS=8000

# Optional GitHub API token (public search also works without it, with lower limits)
GITHUB_TOKEN=

# Optional Google Custom Search JSON API credentials
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Reserved for future Discord bot functionality; current invite lookup uses the public API
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# Reserved for future database persistence; schema exists but is not wired into the app
DATABASE_URL=

# PHP admin console only; configure on the PHP host, never commit this value
ADMIN_PASSWORD_HASH=
